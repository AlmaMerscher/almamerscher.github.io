---
import Layout from "../layouts/Layout.astro";

// Engagements. `group` decides which section an entry lands in; `format` is the chip.
// `date` may be omitted — the row simply renders without one.
// Titles and organizers are German, so they carry lang="de" and hyphenate.
const engagements = [
  // ---- Keynotes & talks -------------------------------------------------
  {
    group: "talk",
    format: "Keynote",
    role: "Abschlusskeynote",
    title: "Einsamkeit und Demokratiedistanz – Was kann politische Bildung leisten?",
    org: "Bundeszentrale für politische Bildung",
    date: "5 September 2025",
    sort: "2025-09-05",
    url: "https://www.engagiert-in-nrw.de/system/files/media/document/file/programm_landwarts_2025.pdf",
  },
  {
    group: "talk",
    format: "Talk",
    role: "Vortrag",
    title: "Einsamkeit und ihre gesundheitlichen, wirtschaftlichen und gesellschaftspolitischen Risiken",
    org: "Volkswagen Foundation",
    date: "3 November 2026",
    sort: "2026-11-03",
    url: "https://www.volkswagenstiftung.de/de/veranstaltungen/einsamkeit-was-gesellschaft-und-gemeinschaft-dagegen-tun-koennen",
  },
  {
    group: "talk",
    format: "Keynote",
    role: "Eröffnungskeynote",
    title: "Einsamkeit",
    org: "Deutsche Sportjugend im DOSB — Auftakt des Projekts NextLevelWir: Sportvereine als Orte gegen Einsamkeit junger Menschen",
    sort: "",
    url: "https://www.dsj.de/news/projektstart-nextlevelwir-gemeinsam-statt-einsam",
  },
  {
    group: "talk",
    format: "Impulse",
    role: "Closing Impuls",
    title: "Wenn Leistung einsam macht",
    org: "Leading Ladies in Finance & DFB",
    sort: "",
    url: "https://www.linkedin.com/posts/dfb-femalebrilliance-ugcPost-7453009276220096512-skjR/",
  },

  // ---- Panels -----------------------------------------------------------
  {
    group: "panel",
    format: "Panel",
    role: "Podiumsdiskussion",
    title: "Einsamkeit: Was Gesellschaft und Gemeinschaft dagegen tun können",
    org: "Volkswagen Foundation",
    date: "3 November 2026",
    sort: "2026-11-03",
    url: "https://www.volkswagenstiftung.de/de/veranstaltungen/einsamkeit-was-gesellschaft-und-gemeinschaft-dagegen-tun-koennen",
  },
  {
    group: "panel",
    format: "Panel",
    role: "Podiumsdiskussion",
    title: "Jugend und politischer Backlash",
    org: "WZB Berlin, Allianz Foundation & Bertelsmann Stiftung",
    date: "2 October",
    sort: "2026-10-02",
    url: "https://www.linkedin.com/posts/alma-merscher_welche-faktoren-pr%C3%A4gen-den-blick-junger-menschen-share-7505556489416339456-BNrk/",
  },

  // ---- Press, radio & podcast -------------------------------------------
  {
    group: "media",
    format: "Press",
    outlet: "Münchner Merkur",
    title: "„Sich allein zu fühlen ist oft auch mit Scham verbunden“",
    org: "Interview zu Einsamkeit bei Menschen im höheren Lebensalter",
    date: "13 October 2026",
    sort: "2026-10-13",
    url: "https://www.ovb-heimatzeitungen.de/blickpunkt/2026/10/13/sich-allein-zu-fuehlen-ist-oft-auch-mit-scham-verbunden.ovb",
  },
  {
    group: "media",
    format: "Radio",
    outlet: "Deutschlandfunk",
    title: "Gesellschaft der Einzelkämpfer? Wie wir heute Gemeinschaft leben",
    sort: "",
    url: "https://www.deutschlandfunk.de/gesellschaft-der-einzelkaempfer-wie-wir-heute-gemeinschaft-leben-100.html",
  },
  {
    group: "media",
    format: "Podcast",
    outlet: "APuZ — Bundeszentrale für politische Bildung",
    title: "Einsamkeit",
    org: "mit Janosch Schobin und Harald Hüttmann",
    sort: "",
    url: "https://www.bpb.de/mediathek/podcasts/apuz-podcast/572331/einsamkeit-mit-janosch-schobin-harald-huettmann-und-alma-merscher/",
  },
  {
    group: "media",
    format: "Press",
    outlet: "GEO",
    title: "Was die Forschung über männliche Einsamkeit weiß",
    org: "Interview, von Miriam Eichhorn-Zachariades",
    sort: "",
    url: "https://www.geo.de/wissen/gesundheit/-was-die-forschung-ueber-maennliche-einsamkeit-weiss--36052584.html",
  },
];

const groups = [
  { key: "media", label: "Press, radio & podcast", cat: "var(--cat-3)" },
  { key: "talk", label: "Keynotes & talks", cat: "var(--cat-1)" },
  { key: "panel", label: "Panel discussions", cat: "var(--cat-2)" },
];

// dated entries newest first, undated ones after, original order preserved within each
const ordered = (key) =>
  engagements
    .filter((e) => e.group === key)
    .map((e, i) => ({ e, i }))
    .sort((a, b) => {
      if (!!a.e.sort !== !!b.e.sort) return a.e.sort ? -1 : 1;
      if (a.e.sort && b.e.sort && a.e.sort !== b.e.sort) return a.e.sort < b.e.sort ? 1 : -1;
      return a.i - b.i;
    })
    .map(({ e }) => e);
---

<Layout
  title="Engagements — Alma-Sophia Merscher"
  description="Keynotes, panel discussions, and press, radio and podcast appearances."
>
  <section class="wrap page">
    <p class="eyebrow">Engagements</p>
    <h1>Talks, panels &amp; media</h1>

    {
      groups.map((g) => (
        <section class="group" style={`--cat:${g.cat}`}>
          <h2 class="group-head">{g.label}</h2>
          <ul class="rows">
            {ordered(g.key).map((e) => (
              <li>
                <a href={e.url} target="_blank" rel="noopener">
                  <span class="chip">{e.format}</span>
                  <span class="body">
                    {e.outlet && <span class="outlet" lang="de">{e.outlet}</span>}
                    <span class="title" lang="de">{e.title}</span>
                    {e.role && <span class="role" lang="de">{e.role}</span>}
                    {e.org && <span class="org" lang="de">{e.org}</span>}
                  </span>
                  <span class="right">
                    {e.date && <span class="date">{e.date}</span>}
                    <span class="arrow" aria-hidden="true">↗</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </section>
</Layout>

<style>
  .page {
    padding: 3rem 1.5rem 4rem;
    max-width: 820px;
  }
  .eyebrow {
    color: var(--accent-deep);
  }
  h1 {
    font-size: 2.1rem;
    margin-bottom: 0.8rem;
  }
  .group {
    margin-top: 2.5rem;
  }
  .group-head {
    font-size: 1.3rem;
    margin-bottom: 0.9rem;
    padding-left: 0.7rem;
    border-left: 3px solid var(--cat);
    border-radius: 0;
  }

  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rows li + li {
    border-top: 1px solid var(--border);
  }
  .rows a {
    display: grid;
    grid-template-columns: 5.5rem 1fr auto;
    gap: 0 1.1rem;
    align-items: start;
    padding: 1.1rem 0.7rem;
    text-decoration: none;
    color: var(--text);
    border-radius: 6px;
    transition: background-color 120ms ease;
  }
  .rows a:hover,
  .rows a:focus-visible {
    background: var(--surface-hover);
  }
  .rows a:focus-visible {
    outline: 2px solid var(--cat);
    outline-offset: 2px;
  }

  .chip {
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--cat);
    padding-top: 0.3rem;
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  .outlet {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .title {
    font-family: var(--font-serif);
    font-size: 1.08rem;
    font-weight: 700;
    line-height: 1.3;
  }
  .role,
  .org {
    font-size: 0.86rem;
    color: var(--text-muted);
    line-height: 1.45;
  }
  .role {
    font-style: italic;
  }

  .right {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    white-space: nowrap;
    padding-top: 0.25rem;
  }
  .date {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
  .arrow {
    color: var(--cat);
    font-size: 0.85rem;
    transition: transform 120ms ease;
  }
  .rows a:hover .arrow {
    transform: translate(2px, -2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .rows a,
    .arrow {
      transition: none;
    }
    .rows a:hover .arrow {
      transform: none;
    }
  }

  @media (max-width: 620px) {
    .rows a {
      grid-template-columns: 1fr auto;
      gap: 0.3rem 0.8rem;
      padding: 1rem 0.5rem;
    }
    .chip {
      grid-column: 1;
      padding-top: 0;
    }
    .right {
      grid-column: 2;
      grid-row: 1;
      padding-top: 0;
    }
    .body {
      grid-column: 1 / -1;
    }
  }
</style>
