---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Alma-Sophia Merscher"
  description="Psychologist at LMU Munich researching loneliness, social cohesion, and how they relate to political attitudes and behaviour."
>
  <section class="hero">
    <picture>
      <source
        media="(min-width: 1001px)"
        srcset="/images/alma-hero-420.webp 420w, /images/alma-hero-840.webp 840w"
        sizes="420px"
      />
      <img
        class="hero-figure"
        src="/images/alma-portrait-320.webp"
        srcset="/images/alma-portrait-320.webp 320w, /images/alma-portrait-640.webp 640w"
        sizes="240px"
        width="320"
        height="401"
        alt="Alma-Sophia Merscher"
        fetchpriority="high"
      />
    </picture>
    <div class="hero-scrim"></div>
    <div class="wrap hero-inner">
      <p class="eyebrow">Welcome</p>
      <h1>Alma-Sophia Merscher</h1>
      <a href="/research" class="button">Read about my research</a>
    </div>
  </section>

  <section class="wrap intro">
    <p class="lead">Welcome, and thank you for stopping by.</p>
    <p>
      I'm a psychologist at LMU Munich. Most of my work is about loneliness and social
      cohesion — what pulls people apart, what holds them together, and how that shapes
      the way we think and act politically. A second strand looks at how stigma and
      loneliness feed into one another.
    </p>
    <p>
      I also run an interest group for early-career researchers working on loneliness, and
      I care a great deal about getting research out of the journals and into the world.
      If any of this speaks to you, or you'd like to join the group, I'd genuinely like to
      hear from you.
    </p>

    <div class="signposts">
      <a class="signpost" href="/research">
        <p class="eyebrow">Research</p>
        <h2>What I work on</h2>
        <p class="desc">Current projects and publications.</p>
      </a>
      <a class="signpost" href="/engagements">
        <p class="eyebrow">Engagements</p>
        <h2>Talks, panels &amp; media</h2>
        <p class="desc">Where to hear or read me next.</p>
      </a>
    </div>
  </section>
</Layout>

<style>
  /* Photo sits to the right, cropped by the band; scrim keeps the headline readable. */
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    /* Flat, and the scrim fades from this exact colour. A gradient here shows through
       where the scrim fades out and reads as a seam down the middle of the band. */
    background: var(--hero-bg-1);
    color: var(--hero-text);
    padding: 5rem 1.5rem;
    min-height: 480px;
    display: flex;
    align-items: center;
  }
  /* display:contents so the <img> itself is the flex item — otherwise the <picture>
     wrapper swallows `order` and the photo can't be moved below the text on mobile. */
  .hero picture {
    display: contents;
  }
  .hero-figure {
    position: absolute;
    top: 0;
    right: max(1.5rem, calc(50% - 450px));
    height: 1040px;
    width: auto;
    z-index: 0;
    pointer-events: none;
    user-select: none;
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      100deg,
      var(--hero-bg-1) 0%,
      rgba(var(--hero-bg-1-rgb), 0.94) 34%,
      rgba(var(--hero-bg-1-rgb), 0.6) 52%,
      rgba(var(--hero-bg-1-rgb), 0) 70%
    );
  }
  .hero .eyebrow {
    color: var(--accent-rust-deep);
  }
  /* width:100% so the flex item keeps .wrap's 900px column instead of shrinking to content */
  .hero-inner {
    width: 100%;
    position: relative;
    z-index: 2;
  }
  /* rem, not ch: ch resolves against the h1's own ~54px font-size and blows past the figure */
  .hero h1 {
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    max-width: 26rem;
    margin-bottom: 1.6rem;
  }
  .hero .tagline {
    max-width: 26rem;
    color: var(--hero-text-muted);
    margin: 0 0 1.6rem;
    font-size: 1.05rem;
  }

  .intro {
    padding: 3.5rem 1.5rem 1rem;
    max-width: 720px;
  }
  .lead {
    font-size: 1.15rem;
  }
  .intro p {
    margin: 0 0 1.2rem;
  }

  .signposts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.25rem;
    margin-top: 2.5rem;
  }
  .signpost {
    text-decoration: none;
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.25rem;
  }
  .signpost:hover {
    border-color: var(--accent-rust);
  }
  .signpost .eyebrow {
    color: var(--accent-rust-deep);
  }
  .signpost h2 {
    font-size: 1.15rem;
    margin: 0 0 0.4rem;
  }
  .signpost .desc {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin: 0;
  }

  /* Below 1000px there is no room for text and figure side by side. Overlapping them
     pushes the head off the top of the band, so stack instead: text, then a
     head-and-shoulders crop at the lower right. No scrim needed. */
  @media (max-width: 1000px) {
    .hero {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      min-height: 0;
      padding: 3.5rem 1.5rem 0;
    }
    .hero-scrim {
      display: none;
    }
    /* order, because <picture> is the first child in the markup but the text should lead */
    .hero-inner {
      order: 1;
    }
    .hero-figure {
      order: 2;
      position: static;
      display: block;
      height: auto;
      width: 62%;
      max-width: 240px;
      margin: 1.75rem 0 0 auto;
    }
  }
</style>
