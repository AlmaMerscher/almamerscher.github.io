---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Speaking — Alma-Sophia Merscher">
  <section class="wrap page">
    <h1>Speaking</h1>
    <p class="intro">Talks, workshops, and panels — add entries here as they come up.</p>

    <ul class="list">
      <li>
        <span class="date">Month Year</span>
        <h2>Sample talk title</h2>
        <p>Venue or event name — one line about the talk.</p>
      </li>
    </ul>
  </section>
</Layout>

<style>
  .page {
    padding: 3rem 1.5rem 4rem;
    max-width: 680px;
  }
  h1 {
    font-size: 2rem;
    margin-bottom: 0.6rem;
  }
  .intro {
    color: var(--text-muted);
    margin: 0 0 2rem;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }
  .date {
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--accent-rust);
    font-weight: 700;
  }
  .list h2 {
    font-size: 1.2rem;
    margin: 0.3rem 0 0.3rem;
  }
  .list p {
    color: var(--text-muted);
    margin: 0;
  }
</style>
