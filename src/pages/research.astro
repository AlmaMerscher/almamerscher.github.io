---
import Layout from "../layouts/Layout.astro";

// Publications, newest first. Every DOI below was resolved against Crossref/DataCite
// and matched its title. Add new entries at the top.
const ME = "Merscher, A.-S.";

const publications = [
  {
    year: "2026",
    authors: "Merscher, A.-S., Hildebrandt, L. K., Sahraoui, J., & Gamer, M.",
    title:
      "Unraveling the behavioral and autonomic dynamics of defensive states in humans in an unconstrained, immersive virtual world",
    venue: "Computers in Human Behavior, 109057.",
    doi: "10.1016/j.chb.2026.109057",
  },
  {
    year: "2026",
    authors: "Merscher, A.-S., Reinhard, M. A., Wolf, J., & Weiß, M.",
    title: "A temporal perspective on loneliness and trustworthiness judgments in everyday life",
    venue: "F1000Research, 15, 667.",
    doi: "10.12688/f1000research.179039.1",
  },
  {
    year: "2026",
    authors:
      "Merscher, A.-S., Akhter-Khan, S. C., Brakemeier, E.-L., Buecker, S., Goodwin, B., Krieger, T., Langenkamp, A., Langkamp, C., Neu, C., Reinhard, M., Schobin, J., Seewer, N., Swader, C., & Wolf, J.",
    title: "Einsamkeit als demokratiepolitische Frage",
    lang: "de",
    venue:
      "In A. Beelmann, E.-L. Brakemeier, U. Wagner & W. G. Weber (Hrsg.), Policy Ultra-Briefs aus der Psychologie und angrenzenden Verhaltenswissenschaften, Reihe 2 – Psychologie und Demokratieförderung. Leibniz-Institut für Psychologie (ZPID).",
    doi: "10.23668/psycharchives.22420",
  },
  {
    year: "2026",
    authors:
      "Göhre, I., Vogel, L., Brückl, T., Hupe, K., Wollinger, J., Wolkenstein, L., Aleksic, M., Merscher, A.-S., Semm, A., Claus, N., Goerigk, S., Kopf-Beck, J., Binder, E., Padberg, F., Reinhard, M. A., Ehring, T., & Bertsch, K.",
    title:
      "Old scars don’t hurt? A systematic review on the association between child maltreatment and adult social functioning",
    venue: "Trauma, Violence, & Abuse. Advance online publication.",
    doi: "10.1177/15248380261439146",
  },
  {
    year: "2024",
    authors: "Merscher, A.-S., & Gamer, M.",
    title:
      "Can I see it in the eyes? An investigation of freezing-like motion patterns in response to avoidable threat",
    venue: "Psychophysiology, 61, e14567.",
    doi: "10.1111/psyp.14567",
  },
  {
    year: "2024",
    authors: "Merscher, A.-S., & Gamer, M.",
    title:
      "Fear lies in the eyes of the beholder—Robust evidence for reduced gaze dispersion upon avoidable threat",
    venue: "Psychophysiology, 61(1), e14421.",
    doi: "10.1111/psyp.14421",
  },
  {
    year: "2022",
    authors: "Merscher, A.-S., Tovote, P., Pauli, P., & Gamer, M.",
    title: "Centralized gaze as an adaptive component of defensive states in humans",
    venue: "Proceedings of the Royal Society B: Biological Sciences, 289(1975), 20220405.",
    doi: "10.1098/rspb.2022.0405",
  },
  {
    year: "2020",
    authors: "Merscher, A.-S., & Gamer, M.",
    title:
      "Freezing of gaze in anticipation of avoidable threat: A threat-specific proxy for freezing-like behavior in humans",
    venue: "ACM Symposium on Eye Tracking Research and Applications (ETRA ’20 Short Papers), Article 33.",
    doi: "10.1145/3379156.3391345",
  },
];
---

<Layout
  title="Research — Alma-Sophia Merscher"
  description="Research on loneliness, connection and wellbeing."
>
  <section class="wrap page">
    <p class="eyebrow">Research</p>
    <h1>What I work on</h1>

    <div class="prose">
      <p class="lead">
        During my PhD in Neuroscience, my research centered around fear and
        anxiety-related defensive states in humans. In a variety of experimental studies,
        we sought to understand how people psychophysiologically react to increasing
        levels of threat. I then became interested in loneliness and first empirical
        findings on a link between loneliness and so-called anti-democratic attitudes and
        behaviors. This motivated me to pursue how robust this link is, which mechanisms
        may lie behind it, and what we could do about it. This research has brought me
        together with a wonderful team of international scientists and non-academic
        stakeholders, gathering at a conference on loneliness and stigma that we organized
        in 2025, funded by the Volkswagen Foundation.
      </p>
    </div>

    <h2 class="section-heading">Publications</h2>
    <ol class="pubs">
      {
        publications.map((p) => (
          <li>
            <span class="year">{p.year}</span>
            <div>
              <p class="authors">
                {/* own name in bold so readers can find it in long author lists */}
                {p.authors.split(ME).map((part, i) =>
                  i === 0 ? (
                    part
                  ) : (
                    <>
                      <strong>{ME}</strong>
                      {part}
                    </>
                  )
                )}
              </p>
              <p class="pub-title" lang={p.lang ?? undefined}>{p.title}</p>
              <p class="venue" lang={p.lang ?? undefined}>{p.venue}</p>
              <p class="meta">
                {p.note && <span class="note">{p.note}</span>}
                <a href={`https://doi.org/${p.doi}`} rel="noopener">
                  doi.org/{p.doi}
                </a>
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>
</Layout>

<style>
  .page {
    padding: 3rem 1.5rem 4rem;
    max-width: 760px;
  }
  .eyebrow {
    color: var(--accent-rust-deep);
  }
  h1 {
    font-size: 2.1rem;
    margin-bottom: 1.5rem;
  }
  .prose {
    line-height: 1.75;
  }
  .prose p {
    margin: 0 0 1.2rem;
  }
  .lead {
    font-size: 1.15rem;
  }
  .section-heading {
    font-size: 1.4rem;
    margin: 3rem 0 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .pubs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }
  .pubs li {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: 0 1rem;
    align-items: start;
  }
  .year {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--accent-rust-deep);
    font-variant-numeric: tabular-nums;
    padding-top: 0.2rem;
  }
  .pubs p {
    margin: 0;
  }
  .authors {
    font-size: 0.88rem;
    color: var(--text-muted);
  }
  .pub-title {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0.15rem 0;
  }
  .venue {
    font-size: 0.88rem;
    color: var(--text-muted);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 0.7rem;
    margin-top: 0.35rem !important;
    font-size: 0.82rem;
  }
  .meta a {
    color: var(--accent-rust-deep);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .meta a:hover {
    text-decoration: underline;
  }
  .note {
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    color: var(--text-muted);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 0.1rem 0.4rem;
  }
  .authors strong {
    font-weight: 700;
    color: var(--text);
  }

  @media (max-width: 520px) {
    .pubs li {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
