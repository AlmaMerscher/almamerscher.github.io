---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Contact — Alma-Sophia Merscher"
  description="How to get in touch, and legal information (Impressum)."
>
  <section class="wrap page">
    <p class="eyebrow">Contact</p>
    <h1>Get in touch</h1>
    <p class="lead">
      For collaborations, media or speaking inquiries, or simply to exchange ideas, please
      contact me.
    </p>

    <ul class="list">
      <li>
        <span class="k">Email</span>
        <a href="mailto:a.merscher@lmu.de">a.merscher@lmu.de</a>
      </li>
      <li>
        <span class="k">LinkedIn</span>
        <a href="https://www.linkedin.com/in/alma-merscher" target="_blank" rel="noopener">
          linkedin.com/in/alma-merscher
        </a>
      </li>
      <li>
        <span class="k">Tackling Loneliness</span>
        <a
          href="https://www.linkedin.com/company/tackling-loneliness/"
          target="_blank"
          rel="noopener"
        >
          linkedin.com/company/tackling-loneliness
        </a>
      </li>
    </ul>

    <!-- Impressum is a legal requirement under § 5 DDG and must stay reachable
         from every page. The footer links straight to this anchor. -->
    <h2 id="impressum" class="section-heading">Impressum</h2>

    <div class="legal" lang="de">
      <p><strong>Angaben gemäß § 5 DDG</strong></p>
      <p>
        Alma-Sophia Merscher<br />
        International Stone Center for Inequality Research<br />
        Ohmstraße 8<br />
        80802 München<br />
        Deutschland
      </p>

      <p><strong>Kontakt</strong></p>
      <p>E-Mail: <a href="mailto:a.merscher@lmu.de">a.merscher@lmu.de</a></p>

      <p><strong>Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV</strong></p>
      <p>
        Alma-Sophia Merscher<br />
        International Stone Center for Inequality Research<br />
        Ohmstraße 8<br />
        80802 München<br />
        Deutschland
      </p>
    </div>
  </section>
</Layout>

<style>
  .page {
    padding: 3rem 1.5rem 4rem;
    max-width: 640px;
  }
  .eyebrow {
    color: var(--accent-deep);
  }
  h1 {
    font-size: 2.1rem;
    margin-bottom: 0.8rem;
  }
  .lead {
    color: var(--text-muted);
    margin: 0 0 2rem;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  /* wraps to two lines rather than overflowing when a real URL is long */
  .list li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.15rem 1rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.8rem;
  }
  .k {
    color: var(--text-muted);
    font-size: 0.85rem;
    flex: none;
  }
  .list a {
    text-decoration: none;
    color: var(--accent-deep);
    font-weight: 500;
    overflow-wrap: anywhere;
    text-align: right;
  }
  .section-heading {
    font-size: 1.4rem;
    margin: 3rem 0 0.8rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    scroll-margin-top: 1.5rem;
  }
  .note {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 0 0 1.5rem;
  }
  .legal {
    font-size: 0.92rem;
    line-height: 1.7;
  }
  .legal p {
    margin: 0 0 1.1rem;
  }
  .legal a {
    color: var(--accent-deep);
  }
</style>
