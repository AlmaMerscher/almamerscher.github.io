---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Alma-Sophia Merscher" } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://almamerscher.github.io");

// Structured data. `knowsAbout` is the standards-compliant way to declare research
// topics to search engines — including the German terms — without hidden text.
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Alma-Sophia Merscher",
  givenName: "Alma-Sophia",
  familyName: "Merscher",
  jobTitle: "Social Psychology Researcher",
  description:
    "Social psychology researcher working on loneliness, social cohesion, and their relationship to political attitudes and behavior.",
  url: "https://almamerscher.github.io/",
  affiliation: {
    "@type": "Organization",
    name: "International Stone Center for Inequality Research, LMU Munich",
    address: {
      "@type": "PostalAddress",
      streetAddress: "Ohmstraße 8",
      postalCode: "80802",
      addressLocality: "München",
      addressCountry: "DE",
    },
  },
  knowsAbout: [
    "Loneliness",
    "Einsamkeit",
    "Loneliness stigma",
    "Einsamkeitsstigma",
    "Social cohesion",
    "Sozialer Zusammenhalt",
    "Social isolation",
    "Soziale Isolation",
    "Political attitudes",
    "Social psychology",
  ],
  knowsLanguage: ["de", "en"],
  sameAs: [
    "https://www.linkedin.com/in/alma-merscher",
    "https://www.linkedin.com/company/tackling-loneliness/",
  ],
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <!-- Google Search Console ownership proof. Public by design, not a secret.
         Leave it in place: removing it un-verifies the property. -->
    <meta
      name="google-site-verification"
      content="ly6ZvQrJrazgT8zhwIvf7Lue3PW-ANCemzaAx1ZzJbs"
    />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:locale:alternate" content="de_DE" />
    <meta name="twitter:card" content="summary" />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>
  <body>
    <header class="site-nav">
      <div class="wrap nav-inner">
        <a href="/" class="brand">Alma-Sophia Merscher</a>
        <nav class="links">
          <a href="/">Welcome</a>
          <a href="/research">Research</a>
          <a href="/engagements">Engagements</a>
          <a href="/interest-group">Interest Group</a>
          <a href="/contact">Contact</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap foot-inner">
        <span>&copy; {new Date().getFullYear()} Alma-Sophia Merscher</span>
        <!-- Impressum must be reachable from every page (§ 5 DDG). -->
        <div class="foot-links">
          <a href="/contact#impressum">Impressum</a>
          <a href="mailto:a.merscher@lmu.de">a.merscher@lmu.de</a>
          <a href="https://www.linkedin.com/in/alma-merscher" target="_blank" rel="noopener">
            LinkedIn
          </a>
          <a href="https://www.linkedin.com/company/tackling-loneliness/" target="_blank" rel="noopener">
            Tackling Loneliness
          </a>
        </div>
      </div>
    </footer>

    <style>
      .site-nav {
        border-bottom: 1px solid var(--text);
      }
      .nav-inner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.1rem 1.5rem;
        font-size: 0.85rem;
        flex-wrap: wrap;
        gap: 0.75rem;
      }
      .brand {
        font-weight: 700;
        text-decoration: none;
      }
      .links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.4rem;
      }
      .links a {
        text-decoration: none;
        font-weight: 500;
      }
      .links a:hover {
        color: var(--accent);
      }
      /* teal band, so the identity colour closes the page as well as opening it */
      .site-foot {
        background: var(--teal-deep);
        color: var(--on-teal-muted);
        margin-top: 4rem;
      }
      .foot-inner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 2rem 1.5rem;
        font-size: 0.8rem;
        color: var(--on-teal-muted);
        flex-wrap: wrap;
        gap: 0.75rem;
      }
      .foot-links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.2rem;
      }
      .foot-links a {
        text-decoration: none;
        color: var(--on-teal-muted);
      }
      /* mustard, not burnt orange: orange on teal is 3.10:1, below the 4.5
         needed for links this size */
      .foot-links a:hover {
        color: var(--mustard);
      }
    </style>
  </body>
</html>
