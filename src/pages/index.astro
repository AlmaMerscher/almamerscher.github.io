---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

const catColor: Record<string, string> = {
  blog: "var(--cat-1)",
  speaking: "var(--cat-4)",
};
---

<Layout title="Alma-Sophia Merscher">
  <section class="hero">
    <picture>
      <source
        media="(min-width: 1001px)"
        srcset="/images/alma-hero-420.webp 420w, /images/alma-hero-840.webp 840w"
        sizes="420px"
      />
      <img
        class="hero-figure"
        src="/images/alma-portrait-320.webp"
        srcset="/images/alma-portrait-320.webp 320w, /images/alma-portrait-640.webp 640w"
        sizes="240px"
        width="320"
        height="401"
        alt="Alma-Sophia Merscher"
        fetchpriority="high"
      />
    </picture>
    <div class="hero-scrim"></div>
    <div class="wrap hero-inner">
      <p class="eyebrow">Welcome</p>
      <h1>A short, clear headline goes here</h1>
      <p class="tagline">One or two sentences introducing you and what this site is about.</p>
      <a href="/blog" class="button">Read the blog</a>
    </div>
  </section>

  <section class="wrap featured">
    <h2 class="section-title">Latest</h2>
    <div class="grid">
      {
        posts.map((post) => (
          <a class="card" href={`/blog/${post.id}`}>
            <p class="eyebrow" style={`color:${catColor[post.data.category]}`}>
              {post.data.category}
            </p>
            <h3>{post.data.title}</h3>
            <p class="desc">{post.data.description}</p>
          </a>
        ))
      }
      {posts.length === 0 && <p class="empty">No posts yet — add one in src/content/blog.</p>}
    </div>
  </section>
</Layout>

<style>
  /* Photo sits to the right, cropped by the band; scrim keeps the headline readable. */
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    /* Flat, and the scrim fades from this exact colour. A gradient here shows through
       where the scrim fades out and reads as a seam down the middle of the band. */
    background: var(--hero-bg-1);
    color: var(--hero-text);
    padding: 5rem 1.5rem;
    min-height: 480px;
    display: flex;
    align-items: center;
  }
  /* display:contents so the <img> itself is the flex item — otherwise the <picture>
     wrapper swallows `order` and the photo can't be moved below the text on mobile. */
  .hero picture {
    display: contents;
  }
  .hero-figure {
    position: absolute;
    top: 0;
    right: max(1.5rem, calc(50% - 450px));
    height: 1040px;
    width: auto;
    z-index: 0;
    pointer-events: none;
    user-select: none;
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      100deg,
      var(--hero-bg-1) 0%,
      rgba(var(--hero-bg-1-rgb), 0.94) 34%,
      rgba(var(--hero-bg-1-rgb), 0.6) 52%,
      rgba(var(--hero-bg-1-rgb), 0) 70%
    );
  }
  .hero .eyebrow {
    color: var(--accent-rust-deep);
  }
  /* width:100% so the flex item keeps .wrap's 900px column instead of shrinking to content */
  .hero-inner {
    width: 100%;
    position: relative;
    z-index: 2;
  }
  /* rem, not ch: ch resolves against the h1's own ~54px font-size and blows past the figure */
  .hero h1 {
    max-width: 26rem;
  }
  .hero .tagline {
    max-width: 26rem;
  }

  /* Below 1000px there is no room for text and figure side by side. Overlapping them
     pushes the head off the top of the band, so stack instead: text, then a
     head-and-shoulders crop at the lower right. No scrim needed. */
  @media (max-width: 1000px) {
    .hero {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      min-height: 0;
      padding: 3.5rem 1.5rem 0;
    }
    .hero-scrim {
      display: none;
    }
    /* order, because <picture> is the first child in the markup but the text should lead */
    .hero-inner {
      order: 1;
    }
    .hero-figure {
      order: 2;
      position: static;
      display: block;
      height: auto;
      width: 62%;
      max-width: 240px;
      margin: 1.75rem 0 0 auto;
    }
  }
  .hero h1 {
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    color: var(--hero-text);
    margin-bottom: 1rem;
  }
  .tagline {
    color: var(--hero-text-muted);
    margin: 0 0 1.6rem;
    font-size: 1.05rem;
  }
  .featured {
    padding: 3.5rem 1.5rem 4rem;
  }
  .section-title {
    font-size: 1.3rem;
    margin-bottom: 1.5rem;
  }
  /* auto-fill, not auto-fit: keeps a single card from stretching the full width */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.5rem;
  }
  .card {
    text-decoration: none;
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.25rem;
  }
  .card:hover {
    border-color: var(--accent-rust);
  }
  .card h3 {
    font-size: 1.1rem;
    margin: 0.2rem 0 0.5rem;
  }
  .desc {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin: 0;
  }
  .empty {
    color: var(--text-muted);
  }
</style>
