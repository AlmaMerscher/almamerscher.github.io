const inProgress = [
  {
    authors: "Merscher, A.-S., Twardawski, M., & Bauer, C.",
    title: "Reframing Loneliness Stigma",
    blurb:
      "A randomized controlled study seeking to counter loneliness stigma and increase social self-efficacy.",
    status: "In data collection",
  },
  {
    authors: "Merscher, A.-S., Göritz, A., & Schobin, J.",
    title:
      "Not all disconnection is equal: Disentangling loneliness from perceived societal misfit as predictors of populist attitudes and voting intentions",
    blurb: "To be submitted shortly.",
    status: "In preparation",
  },
  {
    authors: "Merscher, A.-S., & Weiß, M.",
    title:
      "Stepping back to reconnect? Within- and between-person dynamics of loneliness and social withdrawal across the first university semester",
    blurb:
      "Under revision for the special issue “Advancing Knowledge About Loneliness: Measurements, Pathways, and Intervention Programs from Infancy to Older Adulthood” in the International Journal of Psychology.",
    status: "Under revision",
  },
  {
    authors: "Merscher, A.-S., Gado, S., & Gamer, M.",
    title: "Survival computations in humans",
    blurb:
      "Part of my research at the University of Würzburg. We pit defensive and appetitive tasks against each other and investigate how performance on each competes under increasing levels of threat.",
    status: "In progress",
  },
];

