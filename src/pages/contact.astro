---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact — Alma-Sophia Merscher">
  <section class="wrap page">
    <h1>Contact</h1>
    <p class="intro">The best ways to reach me or find my work.</p>

    <ul class="list">
      <li><span class="k">Email</span><a href="mailto:you@example.com">you@example.com</a></li>
      <li><span class="k">LinkedIn</span><a href="https://linkedin.com" target="_blank" rel="noopener">linkedin.com/in/yourname</a></li>
      <li><span class="k">Google Scholar</span><a href="https://scholar.google.com" target="_blank" rel="noopener">scholar.google.com/yourprofile</a></li>
      <li><span class="k">Instagram</span><a href="https://instagram.com" target="_blank" rel="noopener">@yourhandle</a></li>
    </ul>
  </section>
</Layout>

<style>
  .page {
    padding: 3rem 1.5rem 4rem;
    max-width: 560px;
  }
  h1 {
    font-size: 2rem;
    margin-bottom: 0.6rem;
  }
  .intro {
    color: var(--text-muted);
    margin: 0 0 2rem;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  /* wraps to two lines rather than overflowing when a real URL is long */
  .list li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.15rem 1rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.8rem;
  }
  .k {
    color: var(--text-muted);
    font-size: 0.85rem;
    flex: none;
  }
  .list a {
    text-decoration: none;
    color: var(--accent-rust);
    font-weight: 500;
    overflow-wrap: anywhere;
    text-align: right;
  }
</style>
